from karel.stanfordkarel import *

"""
Karel should fill the whole world with beepers.
"""


def main():
#checks to see if karel is at the top row, if so, she shouldnt return and go up a row
    while front_is_clear():
        if left_is_blocked():
            if left_is_blocked():
                fill_row()
#karel is not on the top row, so she should return and go up a row
        else:
            fill_row()
            return_()
            step_up()

def fill_row():
#pre: front clear
#post: front blocked
    if no_beepers_present():
        #fence post
        put_beeper()
    while front_is_clear():
        move()
        put_beeper()

def return_():
#pre: front blocked
#post: front clear one unit up
    turn_around()
    move_to_wall()
    turn_east()

def turn_around():
    for i in range(2):
        turn_left()

def turn_right():
    turn_around()
    turn_left()

def move_to_wall():
    while front_is_clear():
        move()

def turn_north():
    while not_facing_north():
        turn_left()

def turn_east():
    while not_facing_east():
        turn_left()

def step_up():
    if left_is_clear():
        turn_north()
        move()
        turn_east()

    
# There is no need to edit code beyond this point
if __name__ == '__main__':
    main()
